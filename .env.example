# Kopie als .env.local anlegen und Werte eintragen. Keine Werte hier eintragen.

# Supabase – Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin-Bereich (/admin) – Zugangsdaten
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signatur der Admin-Session (JWT, HS256)
JWT_SECRET=

# Supabase – öffentlicher Anon-Key (Project Settings → API), für Auth und Marktplatz (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (Testmodus) – Developers → API keys; Webhook-Secret lokal aus «stripe listen», auf Vercel aus dem Webhook-Endpunkt
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
