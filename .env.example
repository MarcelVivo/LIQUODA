# Kopie als .env.local anlegen und Werte eintragen. Keine Werte hier eintragen.

# Supabase – Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin-Bereich (/admin) – Zugangsdaten
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signatur der Admin-Session (JWT, HS256)
JWT_SECRET=

# Supabase – öffentlicher Anon-Key (Project Settings → API), für Auth und Marktplatz (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (Testmodus) – Developers → API keys; Webhook-Secret lokal aus «stripe listen», auf Vercel aus dem Webhook-Endpunkt
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Blockchain (Polygon Amoy Testnet)
POLYGON_RPC_URL=
# Nur für lokale Tests gegen eine Hardhat-Kette; in Produktion signiert die Privy-Server-Wallet
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# Privy (eingebettete Wallet, Etappe 7) – dashboard.privy.io → App → Settings
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# E-Mail-Versand (Resend, Etappe 8) – resend.com → API Keys; Domain liquoda.com muss bei Resend freigeschaltet sein
RESEND_API_KEY=
EMAIL_FROM=LIQUODA <noreply@liquoda.com>
EMAIL_ADMIN=info@liquoda.com

# Täglicher Lauf (Vercel Cron) – Vercel sendet den Wert als Bearer-Token an /api/cron/*
CRON_SECRET=

# Privy-Server-Wallet für das Backend (Etappe 10): Schlüssel liegt bei Privy, nie hier. DEPLOYER_PRIVATE_KEY nur noch für lokale Tests.
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=

# KI-Assistent und Support-Bot (Etappe 20) – console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
# Nur nötig, wenn der Schlüssel keinem Workspace zugeordnet ist (Settings → Workspaces → ID «wrkspc_…»)
ANTHROPIC_WORKSPACE_ID=
# Optional: anderes Modell als claude-opus-5
ANTHROPIC_MODEL=
